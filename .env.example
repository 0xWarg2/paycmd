# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_PAYCMD_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=https://heypayna.xyz

# Circle
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-circle-entity-secret
CIRCLE_WALLET_SET_ID=your-circle-wallet-set-id

# OpenRouter (free-model configuration; model availability can change)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_COMMAND_MODEL=inclusionai/ling-3.0-flash:free
# AskSurf UI mapping: Instant/Standard -> Ling Flash; Extended/Maximum -> Laguna S.
OPENROUTER_INSTANT_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_STANDARD_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_EXTENDED_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_MAXIMUM_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_RESEARCH_TIMEOUT_MS=600000

# Legacy AskSurf research (inactive; retain for a future renewal)
# To restore it, configure these values and switch askSurfResearch() back to the
# AskSurf Chat Completions request documented in docs/legacy-asksurf-api.md.
# SURF_API_KEY=your-asksurf-api-key
# SURF_API_BASE_URL=https://api.asksurf.ai/gateway/v1
# SURF_COMMAND_ROUTER_MODEL=surf-1.5-instant
# SURF_TIMEOUT_MS=600000

# Ra onchain receipt proof contract
# Keep disabled until the contract is deployed and the relayer wallet has Arc Testnet USDC gas.
RA_RECEIPT_ENABLED=false
RA_RECEIPT_REGISTRY_ADDRESS=
RA_RECEIPT_REGISTRY_V2_ADDRESS=
NEXT_PUBLIC_RA_RECEIPT_REGISTRY_V2_ADDRESS=
RA_RECEIPT_RELAYER_PRIVATE_KEY=
RA_RECEIPT_RECORDER_ADDRESS=
ARC_TESTNET_RPC_KEY=
NEXT_PUBLIC_ARC_TESTNET_RPC_KEY=

# Payna swap adapter on Arc Testnet
PAYNA_SWAP_ADAPTER_ADDRESS=
NEXT_PUBLIC_PAYNA_SWAP_ADAPTER_ADDRESS=
PAYNA_SWAP_OWNER_ADDRESS=
PAYNA_DEX_ROUTER=0x4d306D129C52E88a7766dc3d70ce28d423E3b1Ef
PAYNA_DEX_FACTORY=0xdE6b2AEf32FE1e675060dBC47BC2dF049052494E
PAYNA_TOKEN_USDC=0x3600000000000000000000000000000000000000
PAYNA_TOKEN_EURC=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
PAYNA_TOKEN_CIRBTC=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF
