# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_PAYCMD_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=https://heypayna.xyz

# Circle
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-circle-entity-secret
CIRCLE_WALLET_SET_ID=your-circle-wallet-set-id
CIRCLE_GATEWAY_WEBHOOK_ENABLED=false
CIRCLE_GATEWAY_ENVIRONMENT=TEST
CIRCLE_GATEWAY_WEBHOOK_URL=https://heypayna.xyz/api/webhooks/circle-gateway
CIRCLE_GATEWAY_WEBHOOK_SUBSCRIPTION_ID=
# Comma-separated Circle Gateway domain IDs to monitor.
CIRCLE_GATEWAY_DOMAINS=26,3,1,6,0,19,2,7,10,5,12,13
PAYCMD_DEFAULT_LOCALE=vi

# DeepSeek (powers both the command router and the research path)
# Put the real key in .env.local, never here.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Only two models exist: deepseek-v4-flash and deepseek-v4-pro.
# Reasoning is ON by default on both, and its tokens come out of the same
# max_tokens budget as the answer. The command router therefore runs with
# thinking disabled so a long chain of thought cannot truncate its JSON.
DEEPSEEK_COMMAND_MODEL=deepseek-v4-flash
# Research effort mapping: Instant/Standard -> flash; Deep -> pro.
DEEPSEEK_INSTANT_MODEL=deepseek-v4-flash
DEEPSEEK_STANDARD_MODEL=deepseek-v4-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
# Keep below the route's maxDuration (300s) so the server gives up first.
DEEPSEEK_RESEARCH_TIMEOUT_MS=240000
# Enables the 10-request lifetime allowance for non-whitelisted users. Keep false until the
# Supabase quota migration has been applied; changing this server-side flag requires redeploying.
DEEPSEEK_QUOTA_ENABLED=false

# Server-only Web3 retrieval. Rotate any key that has appeared in chat, logs, or source control.
TAVILY_API_KEY=your-rotated-tavily-api-key

# Ra onchain receipt proof contract
# Keep disabled until the contract is deployed and the relayer wallet has Arc Testnet USDC gas.
RA_RECEIPT_ENABLED=false
RA_RECEIPT_REGISTRY_ADDRESS=
RA_RECEIPT_REGISTRY_V2_ADDRESS=
NEXT_PUBLIC_RA_RECEIPT_REGISTRY_V2_ADDRESS=
RA_RECEIPT_RELAYER_PRIVATE_KEY=
RA_RECEIPT_RECORDER_ADDRESS=
ARC_TESTNET_RPC_KEY=
NEXT_PUBLIC_ARC_TESTNET_RPC_KEY=

# Payna swap adapter on Arc Testnet
PAYNA_SWAP_ADAPTER_ADDRESS=
NEXT_PUBLIC_PAYNA_SWAP_ADAPTER_ADDRESS=
PAYNA_SWAP_OWNER_ADDRESS=
PAYNA_DEX_ROUTER=0x4d306D129C52E88a7766dc3d70ce28d423E3b1Ef
PAYNA_DEX_FACTORY=0xdE6b2AEf32FE1e675060dBC47BC2dF049052494E
PAYNA_TOKEN_USDC=0x3600000000000000000000000000000000000000
PAYNA_TOKEN_EURC=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
PAYNA_TOKEN_CIRBTC=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF
